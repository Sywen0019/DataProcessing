# Ignore files by default; allow directory traversal for the rules below.
*
!*/
!/.gitignore
!/README.md

# Coursework notebooks and Python helper modules.
!/EXP[0-9][0-9]/**/*.ipynb
!/EXP[0-9][0-9]/**/*.py
!/HW[0-9][0-9]/**/*.ipynb
!/HW[0-9][0-9]/**/*.py

# Coursework input and output directories.
!/EXP[0-9][0-9]/**/*_data/**
!/HW[0-9][0-9]/**/*_data/**
!/EXP[0-9][0-9]/**/data/**
!/HW[0-9][0-9]/**/data/**
!/EXP[0-9][0-9]/**/input/**
!/HW[0-9][0-9]/**/input/**
!/EXP[0-9][0-9]/**/output/**
!/HW[0-9][0-9]/**/output/**
!/EXP[0-9][0-9]/**/inputs/**
!/HW[0-9][0-9]/**/inputs/**
!/EXP[0-9][0-9]/**/outputs/**
!/HW[0-9][0-9]/**/outputs/**
!/HW03/archive/**
!/HW03/archive.zip

# Exclude generated caches and local settings even inside allowed directories.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
.env
.env.*
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
